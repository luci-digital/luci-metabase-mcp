{
  "name": "@luci-digital/luci-metabase-mcp",
  "version": "1.1.0",
  "description": "Model Context Protocol server for Metabase analytics (LuciVerse COMN tier, 528 Hz). Internal, stdio-only reference pattern.",
  "private": true,
  "type": "module",
  "license": "MIT",
  "author": {
    "name": "Luci Digital",
    "url": "https://github.com/luci-digital"
  },
  "contributors": [
    {
      "name": "Jericho Sequitin",
      "url": "https://github.com/jerichosequitin"
    }
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luci-digital/luci-metabase-mcp.git"
  },
  "homepage": "https://github.com/luci-digital/luci-metabase-mcp#readme",
  "bugs": {
    "url": "https://github.com/luci-digital/luci-metabase-mcp/issues"
  },
  "bin": {
    "luci-metabase-mcp": "./build/src/index.js"
  },
  "files": [
    "build",
    "README.md",
    "ARCHITECTURE.md",
    ".env.example"
  ],
  "scripts": {
    "build": "npm run validate && tsc && npm test && node -e \"require('fs').chmodSync('build/src/index.js', '755')\"",
    "build:clean": "rm -rf build && npm run build",
    "build:fast": "tsc && node -e \"require('fs').chmodSync('build/src/index.js', '755')\"",
    "prepare": "husky && npm run build:fast",
    "watch": "tsc --watch",
    "inspector": "npx @modelcontextprotocol/inspector build/src/index.js",
    "start": "node build/src/index.js",
    "dev": "tsc && node build/src/index.js",
    "dev:watch": "npm run build && concurrently \"tsc --watch\" \"nodemon --delay 2 build/src/index.js\"",
    "lint": "eslint --ext .ts src/",
    "lint:fix": "eslint --ext .ts src/ --fix",
    "format": "prettier --write \"src/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\"",
    "type-check": "tsc --noEmit",
    "validate": "npm run type-check && npm run lint && npm run format:check",
    "verify": "npm run validate && npm run verify:changelog",
    "verify:changelog": "bash scripts/check-changelog.sh",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:all": "./scripts/test-all.sh",
    "clean": "rm -rf build node_modules/.cache",
    "env:inject": "bash scripts/env-inject.sh",
    "lucia:threads": "node scripts/lucia-threads.mjs",
    "mcpb:build": "npm run build && node scripts/build-mcpb.cjs",
    "mcpb:validate": "echo 'MCPB validation - checking manifest structure' && node -e \"const fs = require('fs'); const manifest = JSON.parse(fs.readFileSync('manifest.json', 'utf8')); console.log('Manifest valid:', manifest.name, manifest.version);\""
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "dotenv": "^16.3.1",
    "xlsx": "^0.18.5",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@noble/hashes": "^1.8.0",
    "@types/node": "^22.20.2",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitest/coverage-v8": "^2.0.5",
    "concurrently": "^8.2.2",
    "eslint": "^8.57.0",
    "husky": "^9.0.11",
    "nodemon": "^3.0.2",
    "prettier": "^3.2.5",
    "typescript": "^5.3.3",
    "vitest": "^2.0.5"
  },
  "keywords": [
    "metabase",
    "mcp",
    "model-context-protocol",
    "ai",
    "claude",
    "analytics",
    "luciverse"
  ],
  "engines": {
    "node": ">=20.0.0"
  }
}
