# Direnv integration for Nix flakes
# This file automatically activates the dev shell when entering the directory

# Check if we're using Nix
if command -v nix &> /dev/null; then
  # Use flake-based dev shell
  use flake

  # Watch additional files for changes
  watch_file flake.nix
  watch_file flake.lock
  watch_file nix/**/*.nix
else
  # Fallback to traditional development
  echo "Nix not found. Using traditional development setup."

  # Add local bins to PATH
  PATH_add node_modules/.bin
  PATH_add scripts

  # Load .env if it exists
  if [ -f .env ]; then
    dotenv
  fi
fi

# Common environment variables
export EDITOR="${EDITOR:-code}"
export NODE_ENV="${NODE_ENV:-development}"
