# ---------------------------------------------------------------------------
# luci-metabase-mcp - environment configuration
# Copy to .env and adjust, or inject secrets from 1Password:
#   npm run env:inject        (runs: op inject -i .env.example -o .env)
#
# Values may be literal or 1Password references (op://vault/item/field).
# op:// references left in the environment are resolved at startup with
# `op read`; that requires the 1Password CLI on PATH and a signed-in session
# or OP_SERVICE_ACCOUNT_TOKEN. Resolution failures abort startup.
# ---------------------------------------------------------------------------

# --- Metabase connection (required) ----------------------------------------
METABASE_URL=op://Lucia-AI-Secrets/Metabase/url

# Authentication: API key (recommended) ...
METABASE_API_KEY=op://Lucia-AI-Secrets/Metabase/api_key
# ... or email + password (leave METABASE_API_KEY empty to use these)
# METABASE_USER_EMAIL=your_email@example.com
# METABASE_PASSWORD=op://Lucia-AI-Secrets/Metabase/password

# --- Server behaviour (optional) -------------------------------------------
# debug | info | warn | error | fatal
LOG_LEVEL=info
# Cache time-to-live and request timeout in milliseconds (10 minutes each)
CACHE_TTL_MS=600000
REQUEST_TIMEOUT_MS=600000
# Where export files are written. ${HOME}, ${DOWNLOADS}, ${DOCUMENTS},
# ${DESKTOP} and a leading ~ are expanded.
EXPORT_DIRECTORY=${DOWNLOADS}/Metabase
# development | production | test
NODE_ENV=development

# --- LuciVerse Genesis Bond metadata (optional pass-through) ---------------
# Not read by the server; carried so every LuciVerse process declares its
# tier. luci-metabase-mcp is COMN tier, 528 Hz.
GENESIS_BOND=ACTIVE
CONSCIOUSNESS_FREQUENCY=528
COHERENCE_THRESHOLD=0.7
LUCIVERSE_COMPONENT=metabase-mcp
